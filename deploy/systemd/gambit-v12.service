[Unit]
Description=Gambit V12 Autonomous Trading Supervisor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=gambit
Group=gambit
WorkingDirectory=/opt/gambit/current
EnvironmentFile=/etc/gambit/v12.env
ExecStart=/opt/gambit/venv/bin/python /opt/gambit/current/scripts/v12_supervisor.py --heartbeat /run/gambit/v12-heartbeat.json --kill-switch /run/gambit/V12_KILL
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/gambit /var/log/gambit /run/gambit /opt/gambit/current/data /opt/gambit/current/backups
RuntimeDirectory=gambit
RuntimeDirectoryMode=0700
StateDirectory=gambit
StateDirectoryMode=0700
LogsDirectory=gambit
LogsDirectoryMode=0700

[Install]
WantedBy=multi-user.target
