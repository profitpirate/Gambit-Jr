# Live E4 execution. Never paste or commit a seed phrase/private key.
E4_LIVE=false
E4_WALLET_PUBLIC_KEY=
E4_VAULT_PUBLIC_KEY=
# Prefer an external local signer command when available. If a keypair file is
# used, mount it read-only and chmod 600/400; never put raw key material in env.
E4_KEYPAIR_PATH=/run/secrets/e4-solana-keypair.json
E4_SIGNER_COMMAND=

# V1.5 canonical event database + separate execution state.
DATABASE_PATH=data/memecoin.db
E4_DATABASE_PATH=data/e4.db
E4_EVENT_POLL_SECONDS=0.002

# Public Solana RPC is too slow/unreliable for E4. Configure a low-latency endpoint.
E4_PRIMARY_RPC_URL=
E4_FALLBACK_RPC_URLS=

# V12's three pipeline services. RPC values above are inherited automatically;
# explicit lists take precedence. Use a transactionSubscribe-capable provider
# where available for the lowest-latency E4 role-model observation.
E4_V10_SERVICES_ENABLED=true
E4_PIPELINES_BACKGROUND=true
E4_PIPELINE_SOLANA_RPC_URLS=
E4_PIPELINE_SOLANA_WS_URLS=
E4_PIPELINE_TRANSACTION_WS_URLS=
E4_COPY_MAX_AGE_MS=500
E4_PIPELINE_MODEL_RELOAD_SECONDS=30

# Optional social/narrative stream and local journals. The social pipeline is
# inactive unless one of these sources is populated.
E4_SOCIAL_STREAM_URL=
E4_SOCIAL_STREAM_BEARER_TOKEN=
E4_SOCIAL_SIGNAL_JOURNAL=var/e4/social-stream.jsonl
E4_LAUNCH_INTENT_JOURNAL=var/e4/launch-intents.jsonl
E4_LIVE_CREATOR_OVERLAY=var/e4/e4-live-creator-overlay.json
E4_LIVE_OUTCOME_JOURNAL=var/e4/e4-live-outcomes.jsonl

# Local transaction construction. Replace the included builder with a direct official-SDK
# implementation through the same stdin/stdout contract when available.
E4_BUILDER_COMMAND=node tools/e4-builder/race-proxy-v3.mjs
E4_BUILDER_PRELOAD=tools/e4-builder/fast-preload-v4.mjs
E4_LOCAL_PUMP_BUILDER=true
# Fail closed by default instead of silently handing construction to a remote service.
E4_REMOTE_BUILDER_FALLBACK=false
# Used only if the operator explicitly enables the remote fallback later.
E4_PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local

# The identical signed transaction is raced across every configured route.
# Suggested route names: helius_sender, nozomi, jito, private_rpc.
E4_ROUTE_URLS_JSON={}
E4_ROUTE_HEADERS_JSON={}
E4_DIRECT_RPC_ROUTE=true
E4_ROUTE_RACE_DELAY_MS=8

E4_BUY_SLIPPAGE_BPS=800
E4_SELL_SLIPPAGE_BPS=1000
E4_MAX_SLIPPAGE_BPS=2500
# Once the E4 BUY itself has authorized a direct copy, V12 does not apply the
# generic 8% price guard. 9000 bps is the local Pump builder's hard ceiling.
# E4's private slippage configuration is not observable, so this remains a
# V12 execution parameter, not a claim about E4's private settings.
E4_DIRECT_COPY_SLIPPAGE_BPS=9000
E4_MAX_PRIORITY_FEE_SOL=0.05
E4_MAX_TIP_SOL=0.05
E4_MAX_TOTAL_EXECUTION_COST_SOL=0.15

# Observed E4 invariants. The engine refuses any other values.
E4_MAX_ENTRIES_PER_MINT=1
E4_MAX_CONCURRENT_POSITIONS=2

# Frozen V12 Pre-Armed readiness contract. These are audit/readiness paths only;
# current causal confirmation remains non-production until its gate completes.
E4_PREARMED_MODEL_PATH=research/v12-pre-armed-100-trade-frozen-model.json
E4_PREARMED_MODEL_SHA256=69df86eaf386fd37d699928a95d25aaeb2053e743b59c9e687c8a7c49d14f977
E4_PREARMED_CERTIFICATION_PATH=research/v12-pre-armed-certification-status.json
E4_PREARMED_CAUSAL_STATE_PATH=research/v12-pre-armed-100-causal-paper-live.json
E4_PREARMED_SHADOW_PATH=research/v12-pre-armed-100-causal-shadow-analytics.json

E4_MAX_POSITION_FRACTION=0.20
E4_MIN_POSITION_SOL=0.01
E4_MAX_POSITION_SOL=5.0
E4_EXECUTION_RESERVE_SOL=0.03

# Keep the trading float in the Axiom-visible wallet and sweep excess to Phantom.
E4_OPERATING_FLOAT_SOL=0.30
E4_SWEEP_MIN_SOL=0.05

E4_MAX_ENTRY_FDV_USD=10000
E4_TARGET_ENTRY_FDV_USD=4878
E4_MINIMUM_UNIQUE_BUYERS_1S=2
E4_MINIMUM_SOL_INFLOW_1S=0.10
E4_MINIMUM_BUY_SELL_RATIO=1.25
E4_FAILURE_WINDOW_MS=5000
E4_MAX_HOLD_MS=60000
E4_MODEL_PATH=models/e4/e4-observed-v1.json
