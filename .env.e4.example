# Live E4 execution. Never paste or commit a seed phrase/private key.
E4_LIVE=true
E4_WALLET_PUBLIC_KEY=
E4_VAULT_PUBLIC_KEY=
E4_KEYPAIR_PATH=/run/secrets/e4-solana-keypair.json

# V1.5 canonical event database + separate execution state.
DATABASE_PATH=data/memecoin.db
E4_DATABASE_PATH=data/e4.db
E4_EVENT_POLL_SECONDS=0.002

# Public Solana RPC is too slow/unreliable for E4. Configure low-latency endpoints.
E4_PRIMARY_RPC_URL=
E4_FALLBACK_RPC_URLS=

# Persistent local transaction construction. The normal V6 hot path is the official
# Pump SDK builder; PumpPortal is retained only as an explicit emergency fallback.
E4_BUILDER_COMMAND=node tools/e4-builder/daemon.mjs
E4_LOCAL_PUMP_BUILDER=true
E4_ALLOW_REMOTEBUILDER_FALLBACK=false
E4_PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
E4_BUILDER_WORKERS=2
E4_BUILDER_RESPONSE_TIMEOUT_SECONDS=2

# The identical signed transaction is raced across every configured route.
# Suggested route names: helius_sender, nozomi, jito, private_rpc.
E4_ROUTE_URLS_JSON={}
E4_ROUTE_HEADERS_JSON={}
E4_DIRECT_RPC_ROUTE=true
E4_ROUTE_RACE_DELAY_MS=8

E4_BUY_SLIPPAGE_BPS=800
E4_SELL_SLIPPAGE_BPS=1000
E4_MAX_SLIPPAGE_BPS=2500
E4_MAX_PRIORITY_FEE_SOL=0.05
E4_MAX_TIP_SOL=0.05
E4_MAX_TOTAL_EXECUTION_COST_SOL=0.15

# Observed E4 invariants. The engine refuses any other values.
E4_MAX_ENTRIES_PER_MINT=1
E4_MAX_CONCURRENT_POSITIONS=2

# V6 relative sizing is a wallet-fraction ladder inferred from E4. This hard cap
# cannot be raised above 11.5% by configuration.
E4_MAX_POSITION_FRACTION=0.115
E4_MAX_RELATIVE_POSITION_FRACTION=0.115
E4_HIGH_CONVICTION_FRACTION=0.027
E4_MIN_POSITION_SOL=0.01
E4_MAX_POSITION_SOL=5.0
E4_EXECUTION_RESERVE_SOL=0.03

# Keep the trading float in the Axiom-visible wallet and sweep excess to Phantom.
E4_OPERATING_FLOAT_SOL=0.30
E4_SWEEP_MIN_SOL=0.05

# V6 birth-entry universe and independent position deadlines.
E4_MAX_ENTRY_FDV_USD=10000
E4_LIKELY_ENTRY_MIN_FDV_USD=2500
E4_LIKELY_ENTRY_MAX_FDV_USD=10000
E4_LIKELY_ENTRY_MAX_AGE_MS=500
E4_FAILURE_WINDOW_MS=5000
E4_RUNNER_EMERGENCY_HOLD_MS=300000
E4_GUARDIAN_INTERVAL_SECONDS=0.01
E4_PARTIAL_COOLDOWN_MS=200

# Optional precomputed identity/launch-intent caches. Values may be numeric
# confidence in [0,1] or objects such as {"confidence":0.92}.
E4_PREARMED_MINTS_PATH=data/e4/prearmed-mints.json
E4_CREATOR_PROFILES_PATH=data/e4/creator-profiles.json
E4_WALLET_PROFILES_PATH=data/e4/wallet-profiles.json
# Inline JSON alternatives override empty/missing path data.
E4_PREARMED_MINTS_JSON={}
E4_CREATOR_PROFILES_JSON={}
E4_WALLET_PROFILES_JSON={}

E4_MODEL_PATH=models/e4/e4-observed-v1.json
