# Live E4 execution. Never paste or commit a seed phrase/private key.
E4_LIVE=true
E4_WALLET_PUBLIC_KEY=
E4_VAULT_PUBLIC_KEY=
E4_KEYPAIR_PATH=/run/secrets/e4-solana-keypair.json

# V1.5 canonical event database + separate execution state.
DATABASE_PATH=data/memecoin.db
E4_DATABASE_PATH=data/e4.db
E4_EVENT_POLL_SECONDS=0.002

# Public Solana RPC is too slow/unreliable for E4. Configure a low-latency endpoint.
E4_PRIMARY_RPC_URL=
E4_FALLBACK_RPC_URLS=

# Local transaction construction. Replace the included builder with a direct official-SDK
# implementation through the same stdin/stdout contract when available.
E4_BUILDER_COMMAND=node tools/e4-builder/index.mjs
E4_PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local

# The identical signed transaction is raced across every configured route.
# Suggested route names: helius_sender, nozomi, jito, private_rpc.
E4_ROUTE_URLS_JSON={}
E4_ROUTE_HEADERS_JSON={}
E4_DIRECT_RPC_ROUTE=true
E4_ROUTE_RACE_DELAY_MS=8

E4_BUY_SLIPPAGE_BPS=800
E4_SELL_SLIPPAGE_BPS=1000
E4_MAX_SLIPPAGE_BPS=2500
E4_MAX_PRIORITY_FEE_SOL=0.05
E4_MAX_TIP_SOL=0.05
E4_MAX_TOTAL_EXECUTION_COST_SOL=0.15

# Observed E4 invariants. The engine refuses any other values.
E4_MAX_ENTRIES_PER_MINT=1
E4_MAX_CONCURRENT_POSITIONS=2

E4_MAX_POSITION_FRACTION=0.20
E4_MIN_POSITION_SOL=0.01
E4_MAX_POSITION_SOL=5.0
E4_EXECUTION_RESERVE_SOL=0.03

# Keep the trading float in the Axiom-visible wallet and sweep excess to Phantom.
E4_OPERATING_FLOAT_SOL=0.30
E4_SWEEP_MIN_SOL=0.05

E4_MAX_ENTRY_FDV_USD=10000
E4_TARGET_ENTRY_FDV_USD=4878
E4_MINIMUM_UNIQUE_BUYERS_1S=2
E4_MINIMUM_SOL_INFLOW_1S=0.10
E4_MINIMUM_BUY_SELL_RATIO=1.25
E4_FAILURE_WINDOW_MS=5000
E4_MAX_HOLD_MS=60000
E4_MODEL_PATH=models/e4/e4-observed-v1.json
