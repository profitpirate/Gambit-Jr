# Required for the full Discord-first product. Run /menu after invite.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_IDS=
# Optional one-way fallback. Commands require DISCORD_TOKEN.
DISCORD_WEBHOOK_URL=
# Optional authorized-channel social observation. This requires the Message Content
# privileged intent in the Discord application and an explicit channel allowlist.
DISCORD_SOCIAL_OBSERVATION_ENABLED=false
DISCORD_SOCIAL_CHANNEL_IDS=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
DIRECT_LAUNCH_DISCOVERY_ENABLED=false
PUMPFUN_DISCOVERY_ENABLED=false
BNB_LAUNCH_DISCOVERY_ENABLED=false
# Pump.fun program-log subscription. Override only with a chain-verified program id.
PUMPFUN_PROGRAM_IDS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# Four.meme/Flap factory contracts and CREATE event signature topics must come from the
# operator's verified deployment registry. Jr never guesses or silently enables them.
BNB_LAUNCH_FACTORY_ADDRESSES=
BNB_LAUNCH_EVENT_TOPICS=
BNB_LAUNCH_TOKEN_TOPIC_INDEX=1
# Four.meme TokenCreate variants may encode addresses in non-indexed ABI event data.
# Set the verified zero-based 32-byte word positions; leave blank for indexed-topic parsing.
BNB_LAUNCH_TOKEN_DATA_WORD_INDEX=
BNB_LAUNCH_CREATOR_DATA_WORD_INDEX=
EVENT_QUEUE_MAX=2048
LAUNCH_SOURCE_RECONNECT_SECONDS=2
# Canonical realtime fabric. Native Pump program logs are the no-key primary source.
REALTIME_FABRIC_ENABLED=true
PUMPFUN_NATIVE_ENABLED=true
PUMPFUN_CURVE_MONITOR_ENABLED=true
REALTIME_SILENCE_SECONDS=90
REALTIME_BACKFILL_LIMIT=100
REALTIME_PROCESSING_BATCH=100
REALTIME_BACKFILL_MAX_PAGES=20
REALTIME_ENRICHMENT_QUEUE_MAX=2048
REALTIME_ENRICHMENT_CONCURRENCY=4
REALTIME_TOKEN_LANES=8
# PumpPortal is optional redundancy. Its current API key is required; only the free
# new-token and migration subscriptions are used, never metered trade streams.
PUMPPORTAL_API_KEY=
PUMPPORTAL_WEBSOCKET_URL=wss://pumpportal.fun/api/data
# Optional selective standard-RPC Helius monitoring. Standard WSS is free-plan
# available but credit-metered; transactionSubscribe is deliberately not used.
HELIUS_API_KEY=
HELIUS_CURATED_ACCOUNTS=
# Optional corroborating/enrichment providers. Explicit Alchemy URLs override
# endpoints derived from ALCHEMY_API_KEY. Credential-bearing URLs are never logged.
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WSS_URL=
SHYFT_API_KEY=
SHYFT_SOLANA_RPC_URL=
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_RPC_URL=
SOLANA_TRACKER_WSS_URL=
SOLANA_TRACKER_DATA_URL=https://data.solanatracker.io
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
SOLSCAN_API_KEY=
SOLSCAN_BASE_URL=https://pro-api.solscan.io/v2.0
# CoinGecko is slow regime context only and may operate keyless at low volume.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Keyless public Bluesky Jetstream observation remains opt-in.
BLUESKY_SOCIAL_ENABLED=false
# Optional authorized Telegram MTProto observation (install the `social` extra).
TELEGRAM_SOCIAL_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=
# Public preview collector; public channels only, no private-channel bypass.
TELEGRAM_PUBLIC_CHANNELS=
TELEGRAM_PUBLIC_MIN_INTERVAL_SECONDS=1
# Research-only social sources. YouTube searches require explicit high-priority use
# and are cached aggressively.
NEYNAR_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_SECONDS=21600
YOUTUBE_MAX_SEARCHES_PER_PROCESS=8
MASTODON_INSTANCE_URLS=
MASTODON_ACCESS_TOKEN=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai
GMGN_TIMEOUT_SECONDS=10
GMGN_CACHE_TTL_SECONDS=120
GMGN_MAX_RETRIES=2
GMGN_CIRCUIT_FAILURES=4
GMGN_CIRCUIT_COOLDOWN_SECONDS=60
GMGN_CONCURRENCY=4
DATABASE_PATH=/app/data/memecoin.db
# Offline research and live approved-feature databases are deliberately separate.
HISTORICAL_WAREHOUSE_PATH=/app/data/historical/warehouse.db
HISTORICAL_ARCHIVE_PATH=/app/data/archive/historical
APPROVED_FEATURE_STORE_PATH=/app/data/production/approved_features.db
HISTORICAL_LIVE_CONTEXT_ENABLED=true
HISTORICAL_LIVE_LATENCY_BUDGET_MS=25
# Offline historical CLI only; not read by the live critical path.
DUNE_API_KEY=
# Optional compatibility fallback only. Gambit executes its repository-owned
# SQL directly with DUNE_API_KEY; set this only if the Dune plan rejects direct SQL.
DUNE_QUERY_ID=
# Safe by default: an explicit complete-month range, positive cap and dry_run=false
# are all required before controlled acquisition can execute.
DUNE_START_MONTH=
DUNE_END_MONTH=
DUNE_MAX_EXECUTIONS=0
DUNE_DRY_RUN=true
DUNE_QUERY_NAMES=monthly_universe,pumpfun_launches,pumpfun_trades,outcome_reconstruction
DUNE_PARQUET_ROOT=/app/data/historical/parquet
# A bounded server-side sample keeps a pilot small even when one month has tens
# of millions of rows. Set 0 only for an explicitly approved full materialization.
DUNE_PILOT_SAMPLE_ROWS=10000
LOG_LEVEL=INFO
SHADOW_MODE=true
# Deprecated compatibility alias; defaults false. Prefer the two explicit routes.
SHADOW_SEND_ALERTS=false
OPERATOR_SHADOW_ALERTS_ENABLED=false
PUBLIC_ALERTS_ENABLED=false

DISCOVERY_INTERVAL_SECONDS=30
MAX_DISCOVERIES_PER_CYCLE=20
MONITOR_INTERVAL_SECONDS=30
CANDIDATE_MONITOR_INTERVAL_SECONDS=30
CANDIDATE_MAX_AGE_MINUTES=180
CANDIDATE_INACTIVITY_TIMEOUT_MINUTES=30
CANDIDATE_MAX_MARKET_CAP_USD=300000
MIN_SNAPSHOTS_FOR_MOMENTUM=3
MAX_ACTIVE_CANDIDATES=250
SNAPSHOT_HISTORY_LIMIT=12
MAX_ACTIVE_CANDIDATES_PER_CHAIN=125
CANDIDATE_RETRY_INITIAL_SECONDS=30
CANDIDATE_RETRY_MAX_SECONDS=900
CANDIDATE_RETRY_BACKOFF=2
SCHEDULER_FRESH_RESERVED_SLOTS=50
FRESH_RESERVED_SLOTS=50
SCHEDULER_RADAR_RESERVED_SLOTS=50
SCHEDULER_NEAR_SIGNAL_RESERVED_SLOTS=50
GENESIS_RESERVED_SLOTS=50
PRIORITY_RESERVED_SLOTS=50
RADAR_MAX_AGE_MINUTES=15
RADAR_MIN_LIQUIDITY_USD=8000
RADAR_MIN_SNAPSHOTS=2
RADAR_MIN_CONDITIONS=3
RADAR_SCORE_THRESHOLD=60
RADAR_MAX_MARKET_CAP_USD=150000
RADAR_LATE_PUMP_PRICE_CHANGE_PERCENT=300
MISSED_RUNNER_MULTIPLE=5
MAJOR_MISSED_RUNNER_MULTIPLE=10
OUTCOME_MONITOR_INTERVAL_SECONDS=300
OUTCOME_MAX_AGE_HOURS=24
MAX_OUTCOME_WATCHLIST=200
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_CIRCUIT_FAILURES=4
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
MARKET_MAX_AGE_SECONDS=120

MIN_MARKET_CAP_USD=10000
MAX_MARKET_CAP_USD=300000
MIN_LIQUIDITY_USD=10000
MAX_PAIR_AGE_MINUTES=1440
MAX_TOP10_PERCENT=45
REJECT_MINT_AUTHORITY=true
REJECT_FREEZE_AUTHORITY=true

WATCH_THRESHOLD=65
STRONG_THRESHOLD=75
HIGH_CONVICTION_THRESHOLD=85
MIN_CONFIDENCE_FOR_SIGNAL=0.60
WEIGHT_NARRATIVE=25
WEIGHT_SOCIAL=20
WEIGHT_ONCHAIN=20
WEIGHT_DEVELOPER=15
WEIGHT_MOMENTUM=15
WEIGHT_SAFETY=5
SCORING_VERSION=v1.5-runner-failure

MILESTONES=1.5,2,3,5,10,15,20,25,50,100
FAILURE_MULTIPLE=0.30
INACTIVITY_TIMEOUT_HOURS=24
ALERT_COOLDOWN_SECONDS=900
HEALTH_PORT=8080
RADAR_BOARD_ENABLED=false
RADAR_BOARD_PORT=8081
DISCORD_DEFAULT_ALERT_TIER=HOT_PLUS
WATCHLIST_ALERTS_ENABLED=false
DAILY_REPORT_ENABLED=false
MIN_SAMPLE_FOR_EDGE_METRICS=30
SOFTWARE_VERSION=1.5.0
FEATURE_VERSION=v1.5-stage-truth
MODEL_VERSION=deterministic-v1.5
RADAR_VERSION=v1.5-signal-policy
