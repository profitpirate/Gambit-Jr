# Copy to .env.staging only on the staging host. Never reuse production credentials or volumes.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_IDS=
DISCORD_WEBHOOK_URL=

SHADOW_MODE=true
SHADOW_SEND_ALERTS=false
OPERATOR_SHADOW_ALERTS_ENABLED=false
PUBLIC_ALERTS_ENABLED=false
HISTORICAL_LIVE_CONTEXT_ENABLED=true
HISTORICAL_LIVE_LATENCY_BUDGET_MS=25
LOG_LEVEL=INFO

# Container paths are forced again by docker-compose.staging.yml.
DATABASE_PATH=/app/staging/operational/memecoin.db
HISTORICAL_WAREHOUSE_PATH=/app/staging/historical/warehouse.db
HISTORICAL_ARCHIVE_PATH=/app/staging/archive
APPROVED_FEATURE_STORE_PATH=/app/staging/approved/approved_features.db
HEALTH_PORT=8080

# Optional dedicated staging-only Discord test guild/channel may be supplied on the host.
# Never put production channel IDs in this file.
